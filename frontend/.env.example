# Copy to .env.local for local dev. Baked into the static bundle at build
# time (NEXT_PUBLIC_* vars always are) -- not read at runtime.

# Base URL the browser calls for the FastAPI backend, WITHOUT a trailing
# /api (the app's own fetch/WebSocket calls already add that -- see
# src/lib/api.ts). Leave empty/unset for same-origin deployments (the
# docker-compose.yml nginx proxy, and the live Render deployment, are both
# same-origin); the default in src/lib/api.ts (http://localhost:8000)
# already works for local dev without this file.
NEXT_PUBLIC_API_BASE_URL=
