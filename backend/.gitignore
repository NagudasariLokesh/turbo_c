*.pyc
.venv/

# Generated by the build command (copy of frontend/out/) -- not source, see
# README.md for how it's produced.
/static/

# Fetched by the build command (micromamba + a conda-forge gdb env) -- real
# gdb doesn't exist on Render's native runtime and can't be installed via
# apt there (no root), so the build step gets one this way instead. See
# README.md and core/config.py:GDB_BINARY.
/vendor/
